<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now (no Mac for iOS). To add iOS later: append net10.0-ios here and
		     restore Platforms\iOS from the MAUI template (dotnet new maui). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DocScanner</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Platforms/Android/BitmapPixels.cs reads and writes bitmap memory directly (AndroidBitmap_lockPixels). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Doc Scanner</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>btk.docscanner</ApplicationId>

		<!-- Versions. Bump ApplicationVersion (Android versionCode) on every build going to a device or to Play;
		     ApplicationDisplayVersion (versionName) is the human-readable one shown in Settings / About / Play Store.
		     Reset to 1.0 / 1 on 2026-10-05 for the first real Play Console upload (owner's request): prior
		     builds up to 1.3/4 were device/local-AAB testing only, never actually uploaded to Play. versionCode 1
		     was consumed by the Internal testing upload, so Play rejects it on any other track/release ("Version
		     code 1 has already been used"): bumped to 2, versionName stays 1.0 (still the first public version). -->
		<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Release: every assembly compiled ahead of time with LLVM. Mono JIT / plain AOT code is slow for the image loops
	     (measured 2026-09-27, Release, emulator: edge detector 815 -> 481 ms per page, thumbnail 243 -> 153 ms); startup unchanged.
	     Cost: Release build ~12 min instead of ~4, APK 29 -> 42 MB for two ABIs (~21 MB per ABI in a Play bundle). Debug unaffected. -->
	<!-- Debug: JIT instead of the Mono interpreter MAUI turns on for C# Hot Reload. Interpreted, the image loops ran 10-30x
	     slower than Release (Note 10+ Debug build: 1-5 s per black-and-white preview; emulator: warp 2.7-7.3 s vs 0.2 s), so
	     editing felt slow whenever the app was started from Visual Studio. XAML Hot Reload still works; set true to get C#
	     Hot Reload back. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<EnableLLVM>true</EnableLLVM>

		<!-- R8 code shrinking for the Java/Kotlin side (AndroidX, Play Services, ML Kit, the Unity LevelPlay ads
		     SDK and its full Unity Ads network adapter, ...) and .NET/C# IL trimming, same two-lever fix just
		     applied to the sibling PdfReader repo (2026-10-12) after Play Console flagged it under "DEX code
		     optimization" (shrinking/optimization/obfuscation must each be >=25%, enforced from Feb 2027) for
		     exceeding 10 MB. AndroidLinkMode=Full lets .NET for Android prove which bound Java types in a
		     referenced binding assembly are actually reachable, instead of defensively keeping every type in
		     every referenced assembly; AppLovin's AND AdMob's SDKs are both now dropped from this app's
		     dependency graph entirely (the same-day DocScanner.AdsService.{Core,AdMob,AppLovin,LevelPlay} split
		     below, plus removing the app's own direct Plugin.AdMob reference once its only remaining caller,
		     SettingsViewModel.cs's "Privacy options" row, was removed; it was always inert anyway since
		     AdMob is not the active provider). Needs an
		     on-device smoke test of every feature (scan, export, OCR if any, ads, Play Billing, Play Core
		     update) before shipping, not just "it still builds"; see PdfReader.csproj's own comment for the
		     full risk/reward writeup (same lesson applies here unchanged). -->
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidLinkMode>Full</AndroidLinkMode>
	</PropertyGroup>

	<!-- Ads MASTER switch (AdsProviderOptions.IsAdsEnabled in DocScanner.AdsService; same property, same meaning as in
	     PdfReader). Default true = ads on in EVERY build type (Debug, Release, APK, AAB). To build with ads fully off
	     (the ad SDK is not even initialised, nothing loads), either pass -p:AdsEnabled=false:
	       dotnet publish DocScanner.csproj -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsEnabled=false
	     or change the default on the next line. Test/demo ads are served by the ad network itself to registered test
	     devices, so nothing here concerns them. -->
	<PropertyGroup>
		<AdsEnabled Condition="'$(AdsEnabled)' == ''">true</AdsEnabled>
		<DefineConstants Condition="'$(AdsEnabled)' == 'false'">$(DefineConstants);ADS_DISABLED</DefineConstants>
	</PropertyGroup>

	<!-- Release signing (Google Play upload key): keystore + passwords are NOT in this file (this file is
	     tracked by git). They live in release/Signing.props, gitignored — see release/KEYSTORE-README.md.
	     A Release build without that file falls back to the debug key (fine for local device testing; an
	     AAB built that way must not be uploaded to Play, only one built with the real key). -->
	<Import Project="release\Signing.props" Condition="'$(Configuration)' == 'Release' AND Exists('release\Signing.props')" />

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" Color="#5B4FE0" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#5B4FE0" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Plugin.AdMob 10.0.90 needs Microsoft.Maui.Controls >= 10.0.90 (the workload's own default,
		     $(MauiVersion), currently resolves to 10.0.20); pin the newer patch explicitly here. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MIT -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<!-- Apache-2.0 (AndroidX CameraX) / MIT (.NET bindings): the in-app document camera (Platforms/Android/Camera) -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
		<!-- CameraX pulls newer Fragment / Collection; keep their Kotlin-extension packages on the matching versions (NU1608) -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<!-- Apache-2.0: Google Play In-App Updates (force onto the latest Play-published build; no server of our own). -->
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- One project per ad network (2026-10-12 split, replacing the single DocScanner.AdsService project
		     that referenced all three providers' SDKs unconditionally): only the network actually used, Unity
		     LevelPlay (MauiProgram.cs's UseLevelPlayAds call), is referenced, so AppLovin's SDK is never even a
		     candidate dependency here. DocScanner.AdsService.Core (IAdsClient, the banner View/Handler) comes
		     along transitively through this reference. AdMob's own provider project is also NOT referenced
		     (same day: the app's separate direct Plugin.AdMob PackageReference it used to need for
		     SettingsViewModel.cs's "Privacy options" row is gone too, see that file and SettingsPage.xaml).
		     To switch the active provider: reference DocScanner.AdsService.AppLovin or .AdMob here instead and
		     call that project's own UseAppLovinAds/UseAdMobAds in MauiProgram.cs instead of UseLevelPlayAds. -->
		<ProjectReference Include="..\DocScanner.AdsService.LevelPlay\DocScanner.AdsService.LevelPlay.csproj" />
		<ProjectReference Include="..\DocScanner.Core\DocScanner.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="release\" />
	</ItemGroup>

</Project>
