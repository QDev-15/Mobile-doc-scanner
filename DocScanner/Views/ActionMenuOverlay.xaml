<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DocScanner.Views.ActionMenuOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:DocScanner.Services"
    x:DataType="services:ActionMenu"
    IsVisible="{Binding IsOpen}"
    BackgroundColor="#B3000000">

    <!-- The main screen's menus (a document's or folder's three-dot menu, the "move to folder" pickers): the app's own
         rounded, shadowed dialog instead of the system action sheet (square corners, no shadow). Same Border +
         RoundRectangle + Shadow shell as ExportOverlay. Tapping the dimmed area dismisses it. -->
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelCommand}" />
        </Grid.GestureRecognizers>

        <Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" Margin="16" Padding="0,14,0,6" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.35" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <!-- A tap inside the card must not fall through to the scrim's dismiss gesture. -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="0">
                <Label Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" Margin="22,0,22,10"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />

                <ScrollView MaximumHeightRequest="440">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:MenuEntry">
                                <Label Text="{Binding Text}" FontSize="15" Padding="22,13" LineBreakMode="TailTruncation">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Command}" />
                                    </Label.GestureRecognizers>
                                    <Label.TextColor>
                                        <AppThemeBinding Light="{StaticResource OnSurface}" Dark="{StaticResource OnSurfaceDark}" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="TextColor" Value="#D32F2F" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
                <Label Text="{Binding CancelLabel}" FontSize="15" FontFamily="OpenSansSemibold" Padding="22,13" HorizontalTextAlignment="End"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
