<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DocScanner.Views"
    xmlns:ads="clr-namespace:DocScanner.AdsService;assembly=DocScanner.AdsService"
    Title="Thông tin ứng dụng"
    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.Resources>
        <Style x:Key="Section" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="Margin" Value="18,18,18,6" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Style>
        <Style x:Key="Body" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        </Style>
        <Style x:Key="Card" TargetType="VerticalStackLayout">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Spacing" Value="8" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,28">

            <!-- Header -->
            <VerticalStackLayout Padding="16,28,16,12" Spacing="6" HorizontalOptions="Center">
                <!-- The app icon (the image is the rounded blue tile itself) -->
                <Image Source="scanner_logo.png" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center" />
                <Label Text="Doc Scanner" FontSize="24" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                <Label x:Name="VersionLabel" FontSize="13" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                <Label Text="Quét tài liệu bằng điện thoại: nhận diện, nắn thẳng, đen trắng, chữ ký, xuất PDF." FontSize="13"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            </VerticalStackLayout>

            <Label Text="TÁC GIẢ VÀ LIÊN HỆ" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Text="Tác giả: Nguyễn Hữu Quỳnh" FontSize="15" FontFamily="OpenSansSemibold" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmail" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Mail}" FontFamily="Icons" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="nguyenquynhvp.ictu@gmail.com" FontSize="14" TextDecorations="Underline"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPhone" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Phone}" FontFamily="Icons" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="0988 632 841" FontSize="14" TextDecorations="Underline"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </Grid>
                <Label Text="Hỗ trợ, góp ý, báo lỗi: gửi email hoặc gọi số trên." Style="{StaticResource Body}" />
            </VerticalStackLayout>

            <Label Text="ĐIỀU KHOẢN SỬ DỤNG" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Style="{StaticResource Body}"
                       Text="1. Doc Scanner được cung cấp để chụp, xử lý và lưu tài liệu của chính người dùng. Người dùng tự chịu trách nhiệm về nội dung mình quét, ký và chia sẻ, và phải tuân thủ pháp luật về bản quyền, bí mật và dữ liệu cá nhân." />
                <Label Style="{StaticResource Body}"
                       Text="2. Ứng dụng được cung cấp theo hiện trạng. Tác giả không chịu trách nhiệm về thiệt hại phát sinh từ việc mất dữ liệu, sai lệch nội dung sau xử lý hoặc gián đoạn sử dụng; hãy kiểm tra tài liệu trước khi dùng cho mục đích quan trọng và tự sao lưu các tệp cần giữ." />
                <Label Style="{StaticResource Body}"
                       Text="3. Chữ ký đặt trên trang là hình ảnh chữ ký tay, không phải chữ ký số theo quy định về giao dịch điện tử." />
                <Label Style="{StaticResource Body}"
                       Text="4. Không được sao chép, dịch ngược, sửa đổi hay phân phối lại ứng dụng khi chưa có sự đồng ý bằng văn bản của tác giả." />
            </VerticalStackLayout>

            <Label Text="QUYỀN RIÊNG TƯ" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Style="{StaticResource Body}"
                       Text="Ảnh, tài liệu, chữ ký và PDF chỉ được lưu trên điện thoại này và không được gửi đi đâu, trừ khi chính bạn chọn Chia sẻ. Ứng dụng dùng mạng cho quảng cáo (bản miễn phí), xác thực mua Pro, và kiểm tra/bắt buộc cập nhật qua Google Play; không thu thập dữ liệu sử dụng." />
            </VerticalStackLayout>

            <Label Text="BẢN QUYỀN" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Text="© 2026 Nguyễn Hữu Quỳnh. Mọi quyền được bảo lưu." FontSize="14" FontFamily="OpenSansSemibold" />
                <Label Style="{StaticResource Body}" Text="Các thuật toán xử lý ảnh (nhận diện tờ giấy, nắn phối cảnh, đen trắng, làm nét, chữ ký) do tác giả tự viết. Ứng dụng có dùng các thành phần mã nguồn mở sau, theo giấy phép của chúng:" />
                <Label Style="{StaticResource Body}"
                       Text="• .NET, .NET MAUI (MIT) · Microsoft&#10;• CommunityToolkit.Mvvm (MIT) · .NET Foundation&#10;• AndroidX CameraX và các thư viện AndroidX (Apache-2.0) · Google, binding .NET (MIT) · Microsoft&#10;• Material Icons (Apache-2.0) · Google&#10;• Open Sans (SIL Open Font License 1.1) · Google Fonts&#10;• Bộ hiển thị PDF: PdfRenderer có sẵn trong Android&#10;• Play In-App Update, Play Billing, Play services Tasks (Apache-2.0) · Google, binding .NET (MIT) · Microsoft" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <ads:AdBannerSurface Grid.Row="1" />
    </Grid>
</ContentPage>
