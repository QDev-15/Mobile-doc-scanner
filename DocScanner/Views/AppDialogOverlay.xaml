<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DocScanner.Views.AppDialogOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:DocScanner.Services"
    x:DataType="services:AppDialog"
    IsVisible="{Binding IsOpen}"
    BackgroundColor="#B3000000">

    <!-- The main screen's confirm / name-prompt / message dialogs: rounded, shadowed card, same shell as ExportOverlay and
         ActionMenuOverlay, instead of the system alert (square, flat). -->
    <Grid>
        <Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="340" Margin="12" Padding="20,24,20,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.35" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
                <Label Text="{Binding Title}" FontSize="19" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="14" HorizontalTextAlignment="Center" LineHeight="1.25"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                <Entry x:Name="InputEntry" IsVisible="{Binding ShowInput}" Text="{Binding InputText}" Placeholder="{Binding InputPlaceholder}"
                       MaxLength="{Binding InputMaxLength}" ReturnCommand="{Binding AcceptCommand}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0">
                    <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}"
                            HeightRequest="46" CornerRadius="23" FontSize="15" Padding="18,0" BackgroundColor="Transparent" BorderWidth="1.5"
                            BorderColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource MutedDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Button Grid.Column="1" Text="{Binding AcceptText}" Command="{Binding AcceptCommand}" HeightRequest="46" CornerRadius="23" FontSize="15" Padding="6,0" LineBreakMode="NoWrap"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D32F2F" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
