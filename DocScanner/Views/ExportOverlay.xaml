<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DocScanner.Views.ExportOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:DocScanner.Services"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="services:ExportCoordinator"
    IsVisible="{Binding ShowOverlay}"
    BackgroundColor="#B3000000">

    <!-- Full-screen scrim on every screen "Xuất PDF" can be called from. One shared rounded-corner + shadow dialog
         shell (owner's request, 2026-10-13) carries all three states of the flow: asking for a name, showing
         progress, and the result (success with Xem/Chia sẻ, or a failure message); exactly one of IsAskingName /
         IsExporting / IsShowingResult is ever true at a time (ShowOverlay, the scrim's own visibility, is the OR
         of the three). Same Border + RoundRectangle + Shadow pattern HomePage's own cards already use, so these
         dialogs match the rest of the app instead of a plain system alert/action sheet. -->
    <Grid>

        <!-- 1) Ask for a name -->
        <Border IsVisible="{Binding IsAskingName}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300"
                Padding="20,18" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.35" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Label Text="Xuất PDF" FontSize="17" FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <Entry x:Name="NameEntry" Text="{Binding PdfNameInput}" Placeholder="Tên file PDF" ReturnCommand="{Binding ConfirmNameCommand}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Huỷ" Command="{Binding CancelNameCommand}" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Button Grid.Column="1" Text="Xuất" Command="{Binding ConfirmNameCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" TextColor="White" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 2) Progress -->
        <VerticalStackLayout IsVisible="{Binding IsExporting}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsExporting}" Color="White" WidthRequest="48" HeightRequest="48" />
            <Label Text="{Binding ExportText}" TextColor="White" FontSize="16" HorizontalTextAlignment="Center" />
            <Button Text="Huỷ" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>

        <!-- 3) Result. Success: check icon, title, details, then two equal buttons (Xem outlined, Chia sẻ filled = the main
             action) and a quiet Đóng below. Failure: warning icon, the message, and one filled Đóng. -->
        <Border IsVisible="{Binding IsShowingResult}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320"
                Padding="22,26,22,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.35" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Label FontFamily="Icons" FontSize="52" HorizontalOptions="Center" Text="{x:Static views:Icons.Info}" TextColor="#D32F2F">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ResultSuccess}" Value="True">
                            <Setter Property="Text" Value="{x:Static views:Icons.Checked}" />
                            <Setter Property="TextColor" Value="#2E9D5B" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="{Binding ResultTitle}" FontSize="19" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <Label Text="{Binding ResultMessage}" FontSize="13" HorizontalTextAlignment="Center" LineHeight="1.25"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0" IsVisible="{Binding ResultSuccess}">
                    <Button Text="Xem" Command="{Binding ViewResultCommand}" HeightRequest="46" CornerRadius="23" FontSize="15"
                            BackgroundColor="Transparent" BorderWidth="1.5"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Button Grid.Column="1" Text="Chia sẻ" Command="{Binding ShareResultCommand}" HeightRequest="46" CornerRadius="23" FontSize="15"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" />
                </Grid>

                <Button Text="Đóng" Command="{Binding DismissResultCommand}" HeightRequest="44" CornerRadius="22" FontSize="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ResultSuccess}" Value="True">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
