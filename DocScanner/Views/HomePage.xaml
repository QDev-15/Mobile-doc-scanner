<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    xmlns:ads="clr-namespace:DocScanner.AdsService;assembly=DocScanner.AdsService"
    x:DataType="vm:HomeViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <!-- Material 3 Expressive restyle (2026-10-05), from the owner's design: https://claude.ai/artifact/Dwztu6kjeiwL2rP2HXjucE
         Shell's native top bar is turned off (Shell.NavBarIsVisible, above) because that mockup's header, a plain
         title plus round colored pill icon buttons, can't be drawn with Shell's native toolbar items; the header
         below is this page's own, including its own back arrow for folder navigation (GoBackCommand) now that
         Shell's isn't there to provide one. The accent purple and pill/rounded shapes here are literal design
         values (not reusable across unrelated property types as a single XAML token), but the base accent colors
         themselves were moved into Resources/Styles/Colors.xaml's Primary/Secondary/Surface/CardBackground/
         OnSurface/Muted/Divider, so every other page's buttons, switches, active tool icons (ToolButton.cs too),
         backgrounds and text picked up the same palette (2026-10-05b: every other page restyled to match). -->
    <ContentPage.Resources>
        <!-- A folder row: tap to open; drop dragged documents on it to file them there. -->
        <DataTemplate x:Key="FolderRow" x:DataType="vm:FolderItem">
            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="12,10" Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource OnSurface}, Dark=Black}" Opacity="{AppThemeBinding Light=0.06, Dark=0.3}" Radius="6" Offset="0,2" />
                </Border.Shadow>
                <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="13">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                        <DropGestureRecognizer AllowDrop="True" DropCommand="{Binding DropCommand}" />
                    </Grid.GestureRecognizers>
                    <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#FFF2DA, Dark=#3D3120}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="{x:Static views:Icons.FolderFilled}" FontFamily="Icons" FontSize="22"
                               TextColor="{AppThemeBinding Light=#B8863A, Dark=#E0B86A}"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                        <Label Text="{Binding Subtitle}" FontSize="11.5" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="22"
                           WidthRequest="40" HeightRequest="40" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MenuCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A document row: colored icon tile, name, pages · date, a pill badge with the page count. Swipe left to
             delete; long press to select / drag. -->
        <DataTemplate x:Key="DocumentRow" x:DataType="vm:DocumentItem">
            <SwipeView>
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItem Text="Xoá" BackgroundColor="#D32F2F" Command="{Binding DeleteCommand}" />
                    </SwipeItems>
                </SwipeView.RightItems>
                <Border StrokeThickness="0" Padding="12,10" Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource OnSurface}, Dark=Black}" Opacity="{AppThemeBinding Light=0.06, Dark=0.3}" Radius="6" Offset="0,2" />
                    </Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark=#332E52}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,50,*,Auto" ColumnSpacing="13">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            <DragGestureRecognizer CanDrag="True" DragStartingCommand="{Binding DragStartingCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- Tick box, only in selection mode -->
                        <Label IsVisible="{Binding IsSelecting}" Text="{x:Static views:Icons.Unchecked}" FontFamily="Icons" FontSize="24"
                               VerticalOptions="Center" WidthRequest="26" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Text" Value="{x:Static views:Icons.Checked}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border Grid.Column="1" WidthRequest="50" HeightRequest="50" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#EDE8FB, Dark=#342F4D}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Image Source="{Binding Thumb}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="3">
                            <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                            <Label Text="{Binding Subtitle}" FontSize="11.5" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#2E2A48}"
                                Padding="10,4" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="999" />
                            </Border.StrokeShape>
                            <Label Text="{Binding PageCountText}" FontSize="11" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Border>
                    </Grid>
                </Border>
            </SwipeView>
        </DataTemplate>

        <views:HomeRowSelector x:Key="RowSelector" Folder="{StaticResource FolderRow}" Document="{StaticResource DocumentRow}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Header: back arrow only inside a folder (no Shell chrome to provide one anymore); title; then search /
             import PDF / new folder (the one filled, like the mockup's single accent icon) / settings. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="18,16,14,8" ColumnSpacing="10">
            <Border IsVisible="{Binding InFolder}" WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static views:Icons.ChevronLeft}" FontFamily="Icons" FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="21" FontFamily="OpenSansSemibold" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
            <HorizontalStackLayout Grid.Column="2" Spacing="6">
                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Search}" FontFamily="Icons" FontSize="17"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPdfCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Pdf}" FontFamily="Icons" FontSize="17"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewFolderCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.NewFolder}" FontFamily="Icons" FontSize="17"
                           TextColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Settings}" FontFamily="Icons" FontSize="17"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Search: by name, accents ignored, across all folders. -->
        <SearchBar Grid.Row="1" IsVisible="{Binding IsSearching}" Text="{Binding SearchText}" Placeholder="Tìm theo tên tài liệu, thư mục..."
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" x:Name="Search" Margin="18,0,18,8" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RowSelector}" Margin="18,4,18,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="32">
                    <Label Text="{x:Static views:Icons.Scanner}" FontFamily="Icons" FontSize="64" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#C9C2EC, Dark=#4A4568}" />
                    <Label Text="Chưa có tài liệu nào" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Label Text="{Binding EmptyText}" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <!-- Cards already carry their own spacing (Margin) and shadow; no extra item spacing needed here. -->
        </CollectionView>

        <!-- Selection mode, in place of the bottom bar (the list must not move while a document is being dragged):
             count, select all, move to a folder, delete, done. -->
        <Grid Grid.Row="3" ZIndex="2" HeightRequest="64" IsVisible="{Binding IsSelecting}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="4,2,4,2"
              BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#2E2A48}">
            <views:ToolButton Icon="{x:Static views:Icons.Close}" Text="" IconSize="24" Command="{Binding EndSelectionCommand}" />
            <Label Grid.Column="1" Text="{Binding SelectionText}" FontSize="15" FontFamily="OpenSansSemibold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.SelectAll}" Text="Tất cả" Command="{Binding SelectAllCommand}" />
            <views:ToolButton Grid.Column="3" Icon="{x:Static views:Icons.MoveTo}" Text="Chuyển" Command="{Binding MoveSelectedCommand}" />
            <views:ToolButton Grid.Column="4" Icon="{x:Static views:Icons.Delete}" Text="Xoá" Command="{Binding DeleteSelectedCommand}" />
        </Grid>

        <!-- Bottom bar: import · big round scan button (floating above the bar, like the mockup's FAB) · exported PDFs -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*" HeightRequest="76" Padding="16,0" IsVisible="{Binding NotSelecting}"
              BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="0.6" VerticalOptions="Start" Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
            <views:ToolButton Icon="{x:Static views:Icons.Gallery}" Text="Nhập ảnh" Command="{Binding PickFromGalleryCommand}" />
            <Border Grid.Column="1" WidthRequest="60" HeightRequest="60" StrokeThickness="4" TranslationY="-18"
                    Stroke="{AppThemeBinding Light=White, Dark={StaticResource CardBackgroundDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Opacity="0.4" Radius="16" Offset="0,8" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CaptureCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static views:Icons.Camera}" FontFamily="Icons" FontSize="26"
                       TextColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.Pdf}" Text="PDF đã xuất" Command="{Binding OpenExportsCommand}" />
        </Grid>

        <ads:AdBannerSurface Grid.Row="5" />

        <views:ExportOverlay Grid.RowSpan="6" />
    </Grid>
</ContentPage>
