<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:PdfViewerViewModel"
    Title="{Binding Title}"
   >

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Khác" Command="{Binding MoreCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Share}" Size="22"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <Grid>
            <!-- The pages themselves: a continuous, pinch-zoomable scroll (PdfScrollSurface -> PdfScrollView via
                 PdfScrollSurfaceHandler; it draws and handles touch entirely on its own). -->
            <views:PdfScrollSurface x:Name="Surface" />

            <!-- Small floating page indicator, like a real PDF viewer's; updates as the view scrolls. -->
            <Border IsVisible="{Binding HasPage}" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,14" Padding="12,4"
                    StrokeThickness="0" BackgroundColor="#99000000" InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding PageText}" FontSize="12" TextColor="White" />
            </Border>
        </Grid>

        <views:AdBannerSurface Grid.Row="1" />
    </Grid>
</ContentPage>
