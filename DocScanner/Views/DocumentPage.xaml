<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.DocumentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    xmlns:ads="clr-namespace:DocScanner.AdsService;assembly=DocScanner.AdsService"
    x:DataType="vm:DocumentViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nhập PDF" Command="{Binding AddFromPdfCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Pdf}" Size="22"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Đổi tên" Command="{Binding RenameCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Rename}" Size="22"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- What tapping a page does: Xem (viewer, zoom) or Sửa (editor). A two-segment switch. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,8,12,0">
            <Label Text="{Binding ModeHint}" FontSize="12" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <Border Grid.Column="1" StrokeThickness="1" Padding="2"
                    Stroke="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardBackgroundDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="0">
                    <Border Padding="12,5" StrokeThickness="0" BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsViewMode}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetModeCommand}" CommandParameter="view" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" InputTransparent="True">
                            <Label Text="{x:Static views:Icons.View}" FontFamily="Icons" FontSize="16" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsViewMode}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Xem" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsViewMode}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                    <Border Padding="12,5" StrokeThickness="0" BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetModeCommand}" CommandParameter="edit" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" InputTransparent="True">
                            <Label Text="{x:Static views:Icons.Edit}" FontFamily="Icons" FontSize="16" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Sửa" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Background import / processing status: one slim line; the page stays usable while photos keep coming in. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasProgress}"
              Padding="16,4,8,4" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#2E2A48}">
            <ActivityIndicator IsRunning="{Binding IsImporting}" IsVisible="{Binding IsImporting}" WidthRequest="14" HeightRequest="14"
                               Color="{StaticResource Primary}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Label Grid.Column="2" Text="{Binding ImportActionText}" IsVisible="{Binding HasImportAction}" FontSize="13"
                   FontFamily="OpenSansSemibold" Padding="8,6" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ImportActionCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Pages: 3 per row. Tap = edit; long-press and drag onto another page = move it there; ⋮ = page menu. -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Pages}" Margin="8,8,8,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PageItem">
                    <Border StrokeThickness="1" Padding="0"
                            Stroke="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer CanDrag="True" DragStartingCommand="{Binding DragStartingCommand}" />
                            <DropGestureRecognizer AllowDrop="True" DropCommand="{Binding DropCommand}" />
                        </Border.GestureRecognizers>
                        <Grid HeightRequest="156">
                            <Image Source="{Binding Thumb}" IsVisible="{Binding ShowThumb}" Aspect="AspectFit" Margin="4">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Placeholder until the photo has a thumbnail: its place in the document is kept from the start. -->
                            <Grid IsVisible="{Binding ShowPlaceholder}" BackgroundColor="{AppThemeBinding Light=#EFEBFA, Dark=#2A2638}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                    <ActivityIndicator IsRunning="{Binding ShowPlaceholder}" WidthRequest="22" HeightRequest="22"
                                                       Color="{StaticResource Primary}" />
                                    <Label Text="Đang tải..." FontSize="11" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="{Binding StatusText}" IsVisible="{Binding IsFailed}" FontSize="11" Padding="6"
                                   HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" TextColor="#D32F2F">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Preparation progress: copy, thumbnail, screen copy, paper outline. -->
                            <VerticalStackLayout IsVisible="{Binding ShowProgress}" VerticalOptions="End" Spacing="1"
                                                 Padding="5,3" BackgroundColor="#99000000" InputTransparent="True">
                                <Label Text="{Binding StageText}" FontSize="10" TextColor="White" LineBreakMode="TailTruncation" />
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource PrimaryDark}" HeightRequest="3" />
                            </VerticalStackLayout>

                            <!-- Page number badge -->
                            <Border IsVisible="{Binding ShowNumber}"
                                    HorizontalOptions="Start" VerticalOptions="End" Margin="5" Padding="7,1" StrokeThickness="0"
                                    BackgroundColor="#B3000000" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label Text="{Binding NumberText}" FontSize="11" TextColor="White" />
                            </Border>

                            <!-- Page menu -->
                            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0" Padding="0"
                                    WidthRequest="26" HeightRequest="26" StrokeThickness="0" BackgroundColor="#73000000">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="13" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="18" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Undo bar for the last move / delete (snackbar) -->
        <Border Grid.Row="3" IsVisible="{Binding CanUndo}" Margin="12,6,12,6" Padding="14,2,4,2" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#323232, Dark=#E0E0E0}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <Label Text="{Binding UndoText}" VerticalOptions="Center" FontSize="13"
                       TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                <Label Grid.Column="1" Text="HOÀN TÁC" FontSize="13" FontFamily="OpenSansSemibold" Padding="10,10" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Primary}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UndoCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="2" Text="{x:Static views:Icons.Close}" FontFamily="Icons" FontSize="18" Padding="8,10"
                       VerticalOptions="Center" TextColor="{AppThemeBinding Light=#BBBBBB, Dark=#555555}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissUndoCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- Bottom toolbar -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*" HeightRequest="60"
              BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <BoxView Grid.ColumnSpan="4" HeightRequest="0.6" VerticalOptions="Start"
                     Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
            <views:ToolButton Icon="{x:Static views:Icons.AddPhoto}" Text="Chụp thêm" Command="{Binding AddFromCameraCommand}" />
            <views:ToolButton Grid.Column="1" Icon="{x:Static views:Icons.Gallery}" Text="Thư viện" Command="{Binding AddFromGalleryCommand}" />
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.Crop}" Text="Chỉnh sửa" Command="{Binding EditPagesCommand}" />
            <views:ToolButton Grid.Column="3" Icon="{x:Static views:Icons.Pdf}" Text="Xuất PDF" Command="{Binding ExportPdfCommand}" IsActive="True" />
        </Grid>

        <ads:AdBannerSurface Grid.Row="5" />

        <views:ExportOverlay Grid.RowSpan="6" />
    </Grid>
</ContentPage>
