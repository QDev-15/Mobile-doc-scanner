<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme of every system dialog the app shows (Shell DisplayAlert / DisplayPrompt / DisplayActionSheet): rounded card + shadow,
         colours matching the app's cards, accent readable on both light and dark. Wired in by MainActivity (alertDialogTheme). -->
    <style name="AppAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowElevation">24dp</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:colorBackground">@color/dialog_background</item>
        <item name="android:colorBackgroundFloating">@color/dialog_background</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_text_muted</item>
        <item name="colorAccent">@color/dialog_accent</item>
        <item name="colorControlActivated">@color/dialog_accent</item>
        <item name="buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogButton</item>
    </style>

    <!-- Dialog buttons (Lưu / Huỷ / OK...): accent coloured text, no ALL CAPS, readable on the card in light and dark. -->
    <style name="AppDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Applied on top of the activity theme by MainActivity.OnCreate: only points alertDialogTheme at the style above. -->
    <style name="AppDialogThemeOverlay">
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
    </style>
</resources>
