<Project Sdk="Microsoft.NET.Sdk">

  <!-- Provider-agnostic core of the ads library: IAdsClient / AdsClient, the shared AdBannerSurface View +
       Handler, IAdProvider, DisabledAdProvider, and the AdsProviderOptions base. No ad network SDK referenced
       here at all; that is the whole point of the split (2026-10-12, replacing the single DocScanner.AdsService
       project + its AdProviderKind switch): the app references THIS project plus exactly the provider
       project(s) it actually uses (DocScanner.AdsService.AdMob / .AppLovin / .LevelPlay), so an unused
       network's SDK is never even a candidate for the dependency graph, instead of being pulled in and then
       conditionally excluded. Same split just done on the sibling PdfReader repo, applied here because this
       project had the identical single-project shape (and the identical Release DEX bloat risk) before today. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DocScanner.AdsService</RootNamespace>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Maui.Controls/.Compatibility as plain PackageReferences (not UseMaui) is exactly how
         Plugin.AdMob itself is built (checked its .nuspec): gives View / ViewHandler<,> / MauiAppBuilder
         without pulling in the full MAUI SDK project type. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
  </ItemGroup>

</Project>
