<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity LevelPlay (ironSource) ad provider: one project per network (2026-10-12 split of the former
       single DocScanner.AdsService project), so the app, which only uses LevelPlay, never has AdMob's or
       AppLovin's SDKs as even a candidate dependency, instead of pulling all three in and excluding two with
       a build flag. See DocScanner.AdsService.Core.csproj's comment for the full reasoning. Heavier than the
       sibling PdfReader repo's AdsService.LevelPlay project: this app ships the full Unity Ads network
       adapter (not just the bare LevelPlay mediation layer) plus the real GAID binding its own app code calls
       directly, both carried over unchanged from the original combined csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DocScanner.AdsService</RootNamespace>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocScanner.AdsService.Core\DocScanner.AdsService.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity LevelPlay (ironSource) mediation SDK, pulled straight from Maven and auto-bound (.NET for
         Android 9+ feature, no manual Binding project needed). Its own POM requires adquality-sdk in range
         [9.10.0,10.0.0): 9.10.0 is that range's lower/latest bound, no further transitive deps of its own
         (empty dependencies list in its POM). -->
    <AndroidMavenLibrary Include="com.unity3d.ads-mediation:mediation-sdk" Version="9.6.1" />
    <AndroidMavenLibrary Include="com.unity3d.ads-mediation:adquality-sdk" Version="9.10.0" Bind="false" />
    <!-- mediation-sdk above is only the LevelPlay mediation LAYER: by itself it has zero ad networks wired in,
         so every load request waterfalls through nothing and silently never fills (confirmed on-device via
         logcat: "isInitialized=false" immediately followed by a warning naming "com.unity3d.ads.UnityAds",
         LevelPlay's own adapter-loader probing the classpath for the network adapter and finding it absent).
         Unity Ads is Unity's own first-party network and the one every LevelPlay app is expected to ship at
         minimum; adding it requires BOTH the adapter and the base SDK. Bind="false" on both: LevelPlay talks
         to Unity Ads internally (service-loader/reflection), our C# never calls either API directly, so we
         only need the classes present on the classpath, not bound into C#. -->
    <AndroidMavenLibrary Include="com.unity3d.ads-mediation:unityads-adapter" Version="5.14.0" Bind="false" />
    <AndroidMavenLibrary Include="com.unity3d.ads:unity-ads" Version="4.21.0" Bind="false" />
    <!-- unity-ads above has 3 transitive deps with no Microsoft-maintained NuGet (XA4241, not XA4242): added
         raw, Bind="false", same reasoning as the rest of this ItemGroup. -->
    <AndroidMavenLibrary Include="androidx.datastore:datastore" Version="1.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="androidx.datastore:datastore-core" Version="1.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.protobuf:protobuf-kotlin-lite" Version="3.25.6" Bind="false" />
    <AndroidMavenLibrary Include="com.unity3d.coherence:coherencelib" Version="0.2.0" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Java Dependency Verification (XA4242) named these as the exact NuGet packages that already bind the
         deeper transitive deps of the AndroidMavenLibrary items above, instead of auto-binding them a second
         time here (which would clash with the bindings those packages already provide). Versions match what
         was already resolved elsewhere in this solution's dependency graph when this was one shared project
         (alongside Plugin.AdMob, CameraX); found in the local NuGet cache, not guessed. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.32" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Interpolator" Version="1.0.0.37" />
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
    <!-- Official binding for com.google.android.gms:play-services-ads-identifier (switched from a raw
         Bind="false" Maven declaration to this NuGet so the APP ITSELF can call
         AdvertisingIdClient.GetAdvertisingIdInfo() to log the real GAID at startup; cần để chẩn đoán vụ
         LevelPlay không nhận máy test (xem CLAUDE.md). DocScanner/MauiProgram.cs calls this directly, which is
         why it must stay transitively visible to the app project through this ProjectReference chain (the app
         references only DocScanner.AdsService.LevelPlay, not this project's PackageReferences directly). -->
    <PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" Version="118.3.0.3" />
    <!-- For Unity LevelPlay's kotlin-stdlib dependency (XA4242); 2.4.0.1 because Xamarin.AndroidX.Core
         1.19.0.1 (above) already requires at least that version transitively (NU1605 named the exact floor). -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <!-- Same reasoning, named by XA4242 when adding the Unity Ads network adapter + base SDK above. -->
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" Version="1.2.0.8" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0.1" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="2.4.0.1" />
    <PackageReference Include="Square.OkHttp3" Version="5.5.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Work.Runtime.Ktx" Version="2.11.2.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.CroNet" Version="118.1.1.4" />
    <PackageReference Include="Xamarin.Protobuf.JavaLite" Version="4.35.1.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.11.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core.Jvm" Version="1.11.0.1" />
  </ItemGroup>

</Project>
