<Project Sdk="Microsoft.NET.Sdk">

  <!-- AppLovin MAX ad provider: one project per network (2026-10-12 split of the former single
       DocScanner.AdsService project). Not referenced by DocScanner today (LevelPlay is the active provider,
       see DocScanner.AdsService.LevelPlay; AppLovin is not accepting new publishers right now); carried over
       as-is from the single-project version. See DocScanner.AdsService.Core.csproj's comment for the split's
       full reasoning. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DocScanner.AdsService</RootNamespace>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocScanner.AdsService.Core\DocScanner.AdsService.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppLovin MAX SDK, pulled straight from Maven and auto-bound (.NET for Android 9+ feature, no manual
         Binding project needed). Transitive deps are Google-hosted only and Bind="false": we never call their
         Java API directly from C#, we only need the .jar/.aar present so AppLovin's own bytecode resolves;
         binding them too would risk clashing with the Xamarin.AndroidX.* / Xamarin.GooglePlayServices.*
         bindings already pulled in by the packages below. play-services-ads-identifier here (unlike
         DocScanner.AdsService.LevelPlay, which uses the real NuGet binding for the app's own direct GAID
         calls) only needs to satisfy AppLovin's own classpath when this project is the one actually
         referenced, so it stays a raw, unbound Maven dependency, same approach the sibling PdfReader repo's
         AppLovin project uses. -->
    <AndroidMavenLibrary Include="com.applovin:applovin-sdk" Version="13.6.4" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-ads-identifier" Version="17.1.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-appset" Version="16.0.0" Repository="Google" Bind="false" />
    <!-- androidx.browser:browser is NOT declared as a raw AndroidMavenLibrary here: doing so built fine in
         isolation but broke the full app with a D8/R8 duplicate-class error once combined with the app's own
         Xamarin.AndroidX.Browser (pulled in transitively by CameraX elsewhere in DocScanner): two separate
         copies of android.support.customtabs.ICustomTabsCallback$Default. The official NuGet below satisfies
         AppLovin's transitive dependency on it instead, so there is only ever one copy. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Java Dependency Verification (XA4242) named these as the exact NuGet packages that already bind the
         deeper transitive deps of the AndroidMavenLibrary items above, instead of auto-binding them a second
         time here (which would clash with the bindings those packages already provide). Versions match what
         was already resolved elsewhere in this solution's dependency graph when this was one shared project
         (alongside Unity LevelPlay, CameraX); found in the local NuGet cache, not guessed. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.32" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Interpolator" Version="1.0.0.37" />
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
  </ItemGroup>

</Project>
